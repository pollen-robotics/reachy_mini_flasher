{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reachy Mini Flasher",
  "version": "0.2.0",
  "identifier": "com.pollen-robotics.reachy-mini-flasher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Reachy Mini Flasher",
        "width": 680,
        "height": 640,
        "center": true,
        "resizable": false,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "resources": {
      "binaries/rpiboot": "rpiboot"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
