{
  "name": "reachy_mini_flasher",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "Cross-platform (Windows/macOS) Tauri app to reflash the ReachyMiniOS image over USB",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:sim": "REACHY_FLASHER_SIM=1 tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "reset:os": "rm -rf \"$HOME/Library/Application Support/reachy-mini-flasher/images\"",
    "reset:perms": "tccutil reset All com.pollen-robotics.reachy-mini-flasher",
    "reset": "npm run reset:os && npm run reset:perms"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tauri-apps/api": "^2.11.0",
    "motion": "^12.42.2",
    "postprocessing": "^6.39.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
